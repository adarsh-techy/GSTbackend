<?xml version="1.0" encoding="utf-8"?>
<!--
  Base web.config for IIS hosting. `dotnet publish` merges the ASP.NET Core
  Module (aspNetCore) handler + settings into this file automatically.

  The <remove> lines below disable IIS WebDAV, which otherwise intercepts
  PUT / DELETE requests and returns HTTP 405 (Method Not Allowed) before the
  app sees them — breaking endpoints like PUT /api/settings/document-mappings.
  Kestrel (local dev) has no WebDAV, which is why it only fails when hosted.
-->
<configuration>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
  </system.webServer>
</configuration>
